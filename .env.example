# Express API. Every router is mounted under /api (app.js), so the base URL
# has to carry it — without it the calls land on /auth/login and 404.
NEXT_PUBLIC_API_URL=https://pickleball-backend-mwc3.onrender.com/api

# Local backend instead:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Razorpay publishable key, if POST /payments does not return one.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Floating contact buttons on the home page. Each button stays hidden until its
# number is set, so nothing dials a placeholder. WhatsApp takes bare digits with
# the country code and no "+".
# NEXT_PUBLIC_CONTACT_PHONE=+918047182200
# NEXT_PUBLIC_WHATSAPP_NUMBER=918047182200
